NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/land_title_registry
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/land_title_registry
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/land_title_registry_test
